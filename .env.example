# Server
PORT=3000
NODE_ENV=development

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# Model: linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
HUGGINGFACE_MODEL_URL=https://api-inference.huggingface.co/models/linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# SQLite DB path
DB_PATH=./data/plantdisease.db

# File upload limits
MAX_FILE_SIZE_MB=10

# CORS - add your Flutter web origin here
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8080
